{
  "expo": {
    "name": "RelateIQ+",
    "slug": "connectiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "connectiq",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#080A12"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow RelateIQ+ to save contacts to your phone."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RelateIQ+ to access your photos to scan business cards.",
          "cameraPermission": "Allow RelateIQ+ to use your camera to scan business cards."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#080A12"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
